APP_ENV=development
DATABASE_URL=sqlite:///./incidents.db

API_KEY=
LLM_PROVIDER=openai
LLM_API_KEY= Paste_Your_API_Key
LLM_MODEL=gpt-4o-mini
MAX_LLM_CALLS_PER_INCIDENT=6

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_INSTALLATION_ID=
GITHUB_TOKEN= Paste_Your_GitHub_Token
GITHUB_WEBHOOK_SECRET=

ALLOWED_REPOS=Your_Github_User_Name/Your_Repo_Name,local:sample_app
LOCAL_REPOS_DIR=./examples
REQUIRE_APPROVAL=true
AUTO_APPROVE_LOW_RISK=false
MAX_FIX_ATTEMPTS=2
CI_TIMEOUT_S=900